# HTTP server. Cloud Run supplies PORT; the server binds to 0.0.0.0.
PORT=3000

# Optional Gemini server secret. Leave empty for local-guidance-only operation.
# A missing key never prevents the website from starting.
# Configure runtime secrets in AI Studio / Cloud Run, never a VITE_* variable.
# To use free API quota, choose a project on Google's Free Tier in AI Studio.
# Billing tier and available quota belong to that project, not to an app flag.
# Provider data/region terms: https://ai.google.dev/gemini-api/terms
GEMINI_API_KEY=""
# Ordinary optional configuration, not an API secret. This is also the code default.
GEMINI_MODEL="gemini-3.8-flash"

# Attempt limits are per running instance, not a durable per-person/global quota.
# Cold starts/restarts reset them. Use shared durable counters before scaling a pilot.
# Ordinary configuration values: keep 10 / 100 for the initial pilot.
AI_CLIENT_DAILY_LIMIT=10
AI_INSTANCE_DAILY_LIMIT=1500

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
